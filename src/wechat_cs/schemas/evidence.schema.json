{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedEvidenceV02",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_id",
    "source_type",
    "product_id",
    "version",
    "revision",
    "locator",
    "text",
    "content_hash",
    "status",
    "tenant_ids",
    "group_ids",
    "valid_from",
    "valid_until",
    "reviewer",
    "audience",
    "allow_customer_derivation",
    "allow_external_generation",
    "allow_external_embedding",
    "synthetic"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "manual",
        "code",
        "history"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "active",
        "pending",
        "revoked"
      ]
    },
    "tenant_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "group_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "audience": {
      "enum": [
        "customer",
        "internal"
      ]
    },
    "allow_customer_derivation": {
      "type": "boolean"
    },
    "allow_external_generation": {
      "type": "boolean"
    },
    "allow_external_embedding": {
      "type": "boolean"
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
