{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnswerDraftV02",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "customer_reply",
    "evidence_summary",
    "citations",
    "missing_information",
    "risk_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "action": {
      "enum": [
        "answer",
        "clarify",
        "handoff"
      ]
    },
    "customer_reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "evidence_summary": {
      "type": "string",
      "maxLength": 1000
    },
    "citations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "version_unknown",
          "contradiction",
          "internal_only",
          "pii",
          "secret",
          "no_evidence",
          "model_error",
          "injection_suspected",
          "runtime_unknown"
        ]
      }
    }
  }
}
